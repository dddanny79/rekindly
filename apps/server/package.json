{
  "name": "@app/server",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "cli": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "db:generate": "drizzle-kit generate",
    "perf": "tsx src/dev/perf.ts",
    "sample-data": "tsx --env-file-if-exists=../../.env src/dev/seed-sample.ts",
    "showcase-data": "tsx --env-file-if-exists=../../.env src/dev/seed-showcase.ts"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@hono/node-server": "^2.1.4",
    "@hono/zod-validator": "^0.9.1",
    "@node-rs/argon2": "^2.2.2",
    "@simplewebauthn/server": "^14.0.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.13",
    "nodemailer": "^10.1.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "drizzle-kit": "^0.31.11",
    "smtp-server": "^3.19.21",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
