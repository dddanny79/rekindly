{
  "name": "@app/root",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently --names server,web --prefix-colors blue,magenta \"pnpm --filter @app/server dev\" \"pnpm --filter @app/web dev\"",
    "build": "pnpm --filter @app/web build && pnpm --filter @app/server build",
    "start": "node apps/server/dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "license": "AGPL-3.0-or-later",
  "description": "A self-hosted memory for the people in your life",
  "repository": {
    "type": "git",
    "url": "https://github.com/dddanny79/rekindly"
  }
}
