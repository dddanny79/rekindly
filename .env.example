# Copy to .env for local development. Never commit .env.
# All variables are optional; the defaults are shown.

# Port and interface of the server (in production it also serves the web app).
PORT=3000
HOST=0.0.0.0

# Public origin of the app as users open it. Used as WebAuthn relying party (passkeys)
# and to mark the session cookie Secure when it is https. Passkeys only work on
# https:// or http://localhost. In development with `pnpm dev`, use the Vite origin.
# Default: http://localhost:$PORT
PUBLIC_URL=http://localhost:5173

# Database (app.sqlite) and uploaded files (files/). Default: /data when
# NODE_ENV=production, otherwise apps/server/data.
# DATA_DIR=

# Set to true only behind a reverse proxy (Coolify/Traefik, nginx) so the login
# rate limit uses the client address from X-Forwarded-For.
TRUST_PROXY=false

# Port of the Vite dev server (development only). It listens on 0.0.0.0 so the
# app can be opened from other machines, e.g. over Tailscale. /api is proxied to PORT.
WEB_PORT=5173

# Directory with the built web app that the server serves.
# Default: apps/web/dist relative to the server bundle.
# WEB_DIST_DIR=
